# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug / local-only artifacts (NEVER commit)
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
debug.log
debug-*.log
*.tmp
*.bak

# local archives / packaged exports
*.zip
*.tar
*.tar.gz
*.7z
*.rar

# bundled CLIs that shouldn't live in source control.
# Note: keep these as anchored top-level paths (`/inngest`, `/inngest.exe`) so
# the patterns don't accidentally match the `inngest/` source folders nested
# under `src/`. An unanchored `inngest` rule would silently exclude every file
# under `src/features/.../inngest/**` which is exactly the agent code we DO
# want in source control.
/inngest.exe
/inngest

# scratch / probe scripts
debug.*

# env files (can opt-in for committing if needed)
.env*
# …but always commit the example template so contributors know what vars are needed.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Sentry Config File
.env.sentry-build-plugin
