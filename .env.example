# =============================================================================
# REVDEV — environment variables template
# Copy this to `.env.local` and fill in the blanks.
# =============================================================================

# -----------------------------------------------------------------------------
# Clerk Authentication  (https://dashboard.clerk.com/)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/projects
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/projects

# -----------------------------------------------------------------------------
# Convex Database  (https://dashboard.convex.dev/)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CONVEX_URL=https://<your-deployment>.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://<your-deployment>.convex.site
CONVEX_DEPLOYMENT=dev:<your-deployment>
# Internal shared secret used by server-to-Convex calls (rotate per env).
POLARIS_CONVEX_INTERNAL_KEY=

# -----------------------------------------------------------------------------
# AI Providers  (set at least one; OPENAI is the default model)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
# DeepSeek is recommended for users in China where OpenAI/Anthropic may be blocked.
DEEPSEEK_API_KEY=
# (Optional) Override which DeepSeek model the coding agent uses.
# Defaults: coding=`deepseek-v4-flash`, title=`deepseek-v4-flash`.
# `deepseek-v4-flash` (1M ctx, low latency, native tool calling) is optimal
# for interactive vibe-coding sessions. Set DEEPSEEK_CODING_MODEL=deepseek-v4-pro
# for very large refactors where reasoning depth matters more than speed.
# The legacy `deepseek-chat` (V3) and `deepseek-reasoner` (R1) names will be
# sunset on 2026-07-24.
DEEPSEEK_CODING_MODEL=
DEEPSEEK_TITLE_MODEL=

# -----------------------------------------------------------------------------
# Firecrawl (optional — used by the scrape-urls agent tool)
# https://www.firecrawl.dev/
# -----------------------------------------------------------------------------
FIRECRAWL_API_KEY=

# -----------------------------------------------------------------------------
# Sentry — error reporting + source-map upload
# Project: https://sudoshild.sentry.io/projects/revdev/
# -----------------------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Set to "true" to enable Sentry capture during local `npm run dev`.
# Default off so your dev errors don't pollute the production dashboard.
SENTRY_ENABLED_DEV=false

# -----------------------------------------------------------------------------
# Sentry API (Phase E — AI-driven error analysis tools)
# Required scopes: event:read, issue:read, project:read.
# Create at: https://sudoshild.sentry.io/settings/account/api/auth-tokens/
# DO NOT prefix with NEXT_PUBLIC_ — server-only secret.
# -----------------------------------------------------------------------------
SENTRY_AUTH_TOKEN=
SENTRY_ORG_SLUG=sudoshild
SENTRY_PROJECT_SLUG=revdev
SENTRY_PROJECT_ID=4510816205209600
SENTRY_REGION=us
